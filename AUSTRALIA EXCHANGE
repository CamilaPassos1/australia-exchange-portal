                </div>
            </div>
        </section>

        <!-- Contact / Consultation Form -->
        <section id="contact" class="bg-gradient-to-r from-sky-900/40 to-slate-900 border border-sky-500/30 rounded-3xl p-8 sm:p-12 text-center max-w-2xl mx-auto space-y-6">
            <h2 class="text-3xl font-black text-white">Start Your Australian Journey</h2>
            <p class="text-slate-300 text-sm">Schedule a consultation with our exchange agency advisors to select your program and city.</p>
            <form onsubmit="event.preventDefault(); alert('Consultation Request Submitted!');" class="space-y-4 max-w-md mx-auto text-left">
