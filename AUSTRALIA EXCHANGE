                    </div>
                </div>
                <!-- Brisbane / Gold Coast -->
                <div class="bg-slate-800/50 border border-slate-700/60 rounded-2xl p-6 hover:border-sky-500/50 transition">
                    <div class="text-2xl font-bold text-white mb-2">Brisbane / Gold Coast (QLD)</div>
                    <p class="text-slate-400 text-sm mb-4">Subtropical weather, outdoor surf lifestyle, fast-growing economy, and lower cost of living.</p>
                    <div class="space-y-2 text-xs text-slate-300 border-t border-slate-700/50 pt-4">
                        <div class="flex justify-between"><span>Living Cost:</span><span class="font-bold text-sky-400">Moderate ($400-$600/wk)</span></div>                         <div class="flex justify-between"><span>Vibe:</span><span class="font-bold text-slate-200">Sunny & Relaxed</span></div>                     </div>                 </div>             </div>         </section>          <!-- Visa Pathways Section -->         <section id="visas" class="bg-slate-800/30 border border-slate-800 rounded-3xl p-8 sm:p-12 space-y-8">             <div class="text-center max-w-3xl mx-auto">                 <span class="text-sky-400 text-sm font-extrabold uppercase tracking-widest">Visa Framework</span>                 <h2 class="text-3xl font-extrabold text-white mt-1">Visa Subclasses & Eligibility</h2>             </div>             <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">                 <div class="bg-slate-800 p-6 rounded-2xl border border-slate-700">                     <span class="text-sky-400 font-mono text-xs uppercase font-bold">Subclass 500</span>                     <h3 class="text-xl font-bold text-white mt-1 mb-2">Student Visa</h3>                     <p class="text-xs text-slate-400">For courses > 3 months. Work up to 48 hrs/fortnight during terms. Unlimited hours in course breaks.</p>                 </div>                 <div class="bg-slate-800 p-6 rounded-2xl border border-slate-700">                     <span class="text-sky-400 font-mono text-xs uppercase font-bold">Subclass 417 / 462</span>                     <h3 class="text-xl font-bold text-white mt-1 mb-2">Working Holiday</h3>                     <p class="text-xs text-slate-400">Ages 18–30 (or 35 select nationalities). Travel & work full-time up to 1-3 years with regional work.</p>                 </div>                 <div class="bg-slate-800 p-6 rounded-2xl border border-slate-700">                     <span class="text-sky-400 font-mono text-xs uppercase font-bold">Subclass 600</span>                     <h3 class="text-xl font-bold text-white mt-1 mb-2">Visitor Visa</h3>                     <p class="text-xs text-slate-400">Allows short-term study up to 12 weeks. Strictly no work rights allowed during stay.</p>                 </div>                 <div class="bg-slate-800 p-6 rounded-2xl border border-slate-700">                     <span class="text-sky-400 font-mono text-xs uppercase font-bold">Subclass 485</span>                     <h3 class="text-xl font-bold text-white mt-1 mb-2">Temporary Graduate</h3>                     <p class="text-xs text-slate-400">Post-study work visa for Higher Education graduates (2 to 4+ years duration depending on degree level).</p>                 </div>             </div>         </section>          <!-- Interactive Budget Calculator Section -->         <section id="calculator" class="bg-slate-800/80 border border-slate-700 rounded-3xl p-8 sm:p-12">             <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">                 <div class="lg:col-span-5 space-y-4">                     <span class="text-sky-400 text-sm font-extrabold uppercase tracking-widest">Financial Planning</span>                     <h2 class="text-3xl font-extrabold text-white">Interactive Living Cost Estimator</h2>                     <p class="text-slate-400 text-sm">Calculate projected weekly and monthly expenses based on city selection and accommodation preference.</p>                 </div>                 <div class="lg:col-span-7 bg-slate-900/90 rounded-2xl p-6 border border-slate-700 space-y-6">                     <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">                         <div>                             <label class="block text-xs font-bold uppercase text-slate-400 mb-2">Target City</label>                             <select id="citySelect" class="w-full bg-slate-800 border border-slate-700 rounded-lg px-4 py-2.5 text-sm font-semibold text-slate-200 focus:outline-none focus:border-sky-500">                                 <option value="sydney">Sydney ($$$$)</option>                                 <option value="melbourne">Melbourne ($$$)</option>                                 <option value="brisbane">Brisbane ($$)</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase text-slate-400 mb-2">Accommodation Type</label>
