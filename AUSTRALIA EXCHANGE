                <button type="submit" class="w-full bg-sky-500 hover:bg-sky-400 text-slate-950 font-bold py-3.5 rounded-lg text-sm transition shadow-lg shadow-sky-500/20">
                    Request Info
                </button>
            </form>
        </section>

    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-800 py-8 text-center text-xs text-slate-500">
        <p>&copy; 2026 Australia Exchange Agency Portal. Built for counseling & student sales.</p>
    </footer>

    <!-- Calculator JavaScript Script -->
    <script>
        const citySelect = document.getElementById('citySelect');
        const accSelect = document.getElementById('accSelect');
        const weeklyTotal = document.getElementById('weeklyTotal');
        const monthlyTotal = document.getElementById('monthlyTotal');

        const baseCosts = {
            sydney: { share: 300, pbsa: 500, homestay: 380 },
            melbourne: { share: 260, pbsa: 430, homestay: 350 },
            brisbane: { share: 220, pbsa: 380, homestay: 320 }
        };

        const livingExtras = 180; // Utilities, internet, food & public transport

        function calculateCost() {
            const city = citySelect.value;
            const acc = accSelect.value;
            const rent = baseCosts[city][acc];
            const weekly = rent + livingExtras;
            const monthly = Math.round((weekly * 52) / 12);

            weeklyTotal.textContent = `$${weekly} AUD`;
            monthlyTotal.textContent = `$${monthly.toLocaleString()} AUD`;
        }

        citySelect.addEventListener('change', calculateCost);
        accSelect.addEventListener('change', calculateCost);
    </script>
</body>
